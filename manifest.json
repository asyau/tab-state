{
  "manifest_version": 3,
  "name": "Tab State",
  "version": "1.0.0",
  "homepage_url": "https://github.com/asyau/tab-state",
  "description": "Remembers how you used each tab (glanced, skimmed, deep focus, never opened) and where you stopped.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "storage", "idle", "alarms", "scripting", "favicon"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": {
    "default_title": "Open Tab State dashboard",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_page": "ui/settings.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open the Tab State dashboard"
    }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
